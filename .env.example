# ── Public (safe for NEXT_PUBLIC_ — browser-visible, anon key only) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server-only (NEVER prefix with NEXT_PUBLIC_, never commit real values) ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Platform owner bootstrap (used once by supabase/seed_platform_owner.sql) ──
PLATFORM_OWNER_EMAIL=founder@example.com

# ── Rate limiting (Upstash Redis — serverless-safe shared store) ──
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
